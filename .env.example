# Copy to .env and fill in. .env is git-ignored.

# Keepa paid API key — primary automated comp source.
# Without it, the engine still runs on manual Terapeak entry.
KEEPA_API_KEY=

# eBay Marketplace Insights OAuth token (approval-gated).
# Leave blank until access is granted — the eBay source stays dormant.
EBAY_OAUTH_TOKEN=

# SQLite database path (default ./binval.db)
BINVAL_DB=

# Path to cost/threshold table (default ./config/costs.toml)
BINVAL_CONFIG=
